# Copy to .env.local. The defaults run the local demo, so nothing here is needed for `npm run local`.

# local (default) talks to tools/localnet/server.mjs. testnet reads FastNEAR and signs with a wallet.
VITE_NETWORK=local

# The deployed collection. Trust ids are <label>.<collection>.
# Defaults to someday.testnet locally and someday-trust.testnet on testnet.
VITE_COLLECTION_ID=someday.testnet

# The label of the public trust shown at /try.
VITE_PUBLIC_TRUST=nani

# Local server.
VITE_LOCAL_RPC=http://127.0.0.1:8787

# Testnet reads.
VITE_RPC_URL=https://rpc.testnet.fastnear.com

# Testnet only. The public trust has one holder account, so people with no wallet need a relay to
# send their attempts. POST <relay>/attempt { trust, amount, message }.
VITE_RELAY_URL=
